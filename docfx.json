{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [{ "files": ["src/**/*.csproj"] }],
      "dest": "api",
      "filter": "docs/api-filter.yml",
      "namespaceLayout": "nested"
    }
  ],
  "build": {
    "content": [
      { "files": ["api/**.yml", "api/index.md"] },
      { "files": ["index.md", "toc.yml", "README.md", "CONTRIBUTING.md", "CLAUDE.md", "src/**/CLAUDE.md", "docs/**.md"] }
    ],
    "resource": [{ "files": ["deploy/**", ".editorconfig", ".github/workflows/*.yml"] }],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "container-forest",
      "_appTitle": "container-forest",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
