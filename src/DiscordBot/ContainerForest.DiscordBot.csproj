<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- Development only: the service token lives in user secrets, never in appsettings. -->
    <UserSecretsId>container-forest-discord-bot</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Contracts\bot\bot.proto" ProtoRoot="..\Contracts" GrpcServices="Client" Link="Contracts\bot.proto" />
  </ItemGroup>

</Project>
