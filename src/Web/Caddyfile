# The single entry point of container-forest (ADR-0005): the panel's files, its API, and gRPC for agents and the bot.
#
#   CF_SITE_ADDRESS     what Caddy serves: a domain (forest.example.com) gets a Let's Encrypt certificate and
#                       listens on 80 and 443; ":8080" (the default) is plain HTTP, for local runs or behind
#                       another proxy that ends TLS.
#   CF_AGGREGATOR_URL   the aggregator's REST/SignalR address (default aggregator:5080)
#   CF_AGGREGATOR_GRPC  the aggregator's gRPC address (default aggregator:5081)
{
	# Agents and the bot open HTTP/2 to this address; without TLS that is cleartext HTTP/2 (h2c).
	servers {
		protocols h1 h2 h2c h3
	}
}

{$CF_SITE_ADDRESS::8080} {
	# Agents and the bot: every gRPC call, whatever its path. The streams live for hours, so the response is
	# flushed as it comes and no timeout applies (Caddy sets none by default).
	@grpc header Content-Type application/grpc*
	handle @grpc {
		reverse_proxy h2c://{$CF_AGGREGATOR_GRPC:aggregator:5081} {
			flush_interval -1
		}
	}

	# The panel's API and SignalR on the same origin: SameSite=Strict cookies and WebSockets without CORS.
	# Caddy passes X-Forwarded-For/Proto/Host; the aggregator trusts them (ASPNETCORE_FORWARDEDHEADERS_ENABLED).
	handle /api/* {
		reverse_proxy {$CF_AGGREGATOR_URL:aggregator:5080}
	}
	handle /hubs/* {
		reverse_proxy {$CF_AGGREGATOR_URL:aggregator:5080}
	}

	# The SPA. Unlike nginx's add_header, these apply to every response below, whatever block answers it.
	handle {
		root * /srv
		encode zstd gzip
		header {
			Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy same-origin
			-Server
		}

		# Hashed file names: cached for good. A missing one is a 404, not the app with that cache header.
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Client-side routes get the app, which is checked on every load.
		handle {
			header Cache-Control no-cache
			try_files {path} /index.html
			file_server
		}
	}
}
